---
layout: _base.njk
---

<article class="container blog-post">
    <header class="blog-post__header">
        <h1 class="blog-post__title">{{ title }}</h1>
        <div class="blog-post__meta">
            <time class="blog-post__date" datetime="{{ date }}">
                {{ date | localeDate }}
            </time>
            {% if category %}
            <span class="blog-post__category">
                <i class="fas fa-folder"></i> {{ category }}
            </span>
            {% endif %}
        </div>
        {% if tags %}
        <div class="blog-post__tags">
            {% for tag in tags %}
            {% if tag != "posts" %}
            <span class="blog-post__tag">
                <i class="fas fa-tag"></i> {{ tag }}
            </span>
            {% endif %}
            {% endfor %}
        </div>
        {% endif %}
    </header>
    
    <div class="blog-post__content">
        {{ content | safe }}
    </div>

    <footer class="blog-post__footer">
        <a href="/blog" class="blog-post__back-link">
            <i class="fas fa-arrow-left"></i> Back to Blog
        </a>
    </footer>
</article>

